@@ -9,14 +9,33 @@
                 {{> components/common/alert-error forms.create_account.error}}
             {{/if}}
             {{#if settings.account_creation_enabled}}
-                <form action="{{urls.auth.save_new_account}}" data-create-account-form method="post" class="form">
+                {{!--
+                    SIMPLIFIED SIGNUP (email + password only)
+                    ========================================
+                    BigCommerce locks the built-in name and Address fields as "Required"
+                    ("This value is not configurable" in Settings > Account Signup Form),
+                    because the Address fields are shared with checkout and the address book.
+                    They therefore CANNOT be made optional in the admin -- the theme has to
+                    handle them. This template:
+
+                      * Shows only Email, Password and Confirm Password (see the style block).
+                      * Hides + auto-fills the required First/Last name from the email
+                        (real name is captured at checkout and overwrites the placeholder).
+                      * Wraps the Address block in [data-address-fields-block] so the script
+                        can either REMOVE it (no address submitted) or KEEP it hidden and
+                        auto-fill placeholder values -- controlled by SUBMIT_PLACEHOLDER_ADDRESS
+                        in the script below. See docs/simplified-signup.md.
+                --}}
+                <form action="{{urls.auth.save_new_account}}" data-create-account-form method="post" class="form simplified-signup">
                     <div class="form-row form-row--half">
                         {{#each forms.create_account.account_fields }}
                             {{{dynamicComponent 'components/common/forms'}}}
                         {{/each}}
-                        {{#each forms.create_account.address_fields }}
-                            {{{dynamicComponent 'components/common/forms'}}}
-                        {{/each}}
+                        <div data-address-fields-block>
+                            {{#each forms.create_account.address_fields }}
+                                {{{dynamicComponent 'components/common/forms'}}}
+                            {{/each}}
+                        </div>
                         {{inject 'required' (lang 'common.required')}}
                         {{inject 'state_error' (lang 'errors.state_error')}}
                     </div>
@@ -25,6 +44,97 @@
                         <input type="submit" class="button button--primary" value="{{lang 'forms.create_account.submit_value' }}" />
                     </div>
                 </form>
+
+                {{!-- Show only Email + Password; hide the name fields and the address block. --}}
+                <style>
+                    .simplified-signup .form-field[data-type="FirstName"],
+                    .simplified-signup .form-field[data-type="LastName"],
+                    .simplified-signup .form-field[data-type="CompanyName"],
+                    .simplified-signup .form-field[data-type="Phone"],
+                    .simplified-signup [data-address-fields-block] { display: none !important; }
+                </style>
+
+                <script>
+                    (function () {
+                        // ----------------------------------------------------------------
+                        // false  = REMOVE the address block entirely (nothing submitted).
+                        //          Try this first. If signup then fails with an
+                        //          "address is required" error, switch to true.
+                        // true   = keep the address block hidden and auto-fill placeholder
+                        //          values so the form always submits (creates a placeholder
+                        //          address the customer replaces at checkout).
+                        // ----------------------------------------------------------------
+                        var SUBMIT_PLACEHOLDER_ADDRESS = false;
+
+                        // Placeholders used until real details are captured at checkout.
+                        var DEFAULT_FIRST = 'Collector';
+                        var DEFAULT_LAST = 'Member';
+                        var DEFAULT_TEXT = 'N/A';
+                        var TYPE_PLACEHOLDER = { Zip: '00000', Phone: '0000000000' };
+                        var HIDDEN_ACCOUNT_TYPES = ['CompanyName', 'Phone'];
+
+                        var form = document.querySelector('[data-create-account-form]');
+                        if (!form) { return; }
+
+                        function each(list, fn) { Array.prototype.slice.call(list || []).forEach(fn); }
+                        function titleCase(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }
+
+                        // In REMOVE mode, drop the whole address block up front (synchronously,
+                        // before the theme's validator runs) so it is neither validated nor sent.
+                        if (!SUBMIT_PLACEHOLDER_ADDRESS) {
+                            each(form.querySelectorAll('[data-address-fields-block]'), function (el) { el.remove(); });
+                        }
+
+                        function deriveNames() {
+                            var email = form.querySelector('[data-field-type="EmailAddress"]');
+                            var local = (email && email.value) ? email.value.split('@')[0] : '';
+                            var parts = local.split(/[._+\-]+/).filter(Boolean).map(titleCase);
+                            var first = parts[0] || DEFAULT_FIRST;
+                            var last = parts.length > 1 ? parts[parts.length - 1] : DEFAULT_LAST;
+                            each(form.querySelectorAll('[data-field-type="FirstName"]'), function (i) { i.value = first; });
+                            each(form.querySelectorAll('[data-field-type="LastName"]'), function (i) { i.value = last; });
+                        }
+
+                        function fillRequiredHidden(input) {
+                            if (input.getAttribute('aria-required') !== 'true' || input.value) { return; }
+                            if (input.tagName === 'SELECT') {
+                                for (var k = 0; k < input.options.length; k++) {
+                                    if (input.options[k].value) { input.value = input.options[k].value; break; }
+                                }
+                            } else {
+                                var type = input.getAttribute('data-field-type');
+                                input.value = TYPE_PLACEHOLDER[type] || DEFAULT_TEXT;
+                            }
+                        }
+
+                        function fillAll() {
+                            deriveNames();
+                            each(form.querySelectorAll('[data-field-type]'), function (input) {
+                                var type = input.getAttribute('data-field-type');
+                                if (type === 'FirstName' || type === 'LastName') { return; } // handled above
+                                var inBlock = input.closest && input.closest('[data-address-fields-block]');
+                                if (HIDDEN_ACCOUNT_TYPES.indexOf(type) !== -1 || (SUBMIT_PLACEHOLDER_ADDRESS && inBlock)) {
+                                    fillRequiredHidden(input);
+                                }
+                            });
+                        }
+
+                        function ready(fn) {
+                            if (document.readyState !== 'loading') { fn(); return; }
+                            document.addEventListener('DOMContentLoaded', fn);
+                        }
+                        ready(function () {
+                            fillAll();
+                            var email = form.querySelector('[data-field-type="EmailAddress"]');
+                            if (email) {
+                                email.addEventListener('input', deriveNames);
+                                email.addEventListener('blur', deriveNames);
+                            }
+                            // Safety net: guarantee non-empty values right before the validator runs.
+                            form.addEventListener('submit', fillAll, true);
+                        });
+                    }());
+                </script>
             {{/if}}
         </div>
     </div>
